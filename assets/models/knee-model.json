 "illustrations": {
  "cartilage-femur, cartilage-tibia, cartilage-patella": "a 1.6 mm layer, thinning to the bone over its last 2.5 mm, over the joint surfaces of the real femur (where it faces the tibia, the groove the kneecap runs in, and the back of the condyles), tibia (plateau, not the central spines) and the back of the kneecap; thickness for visibility (AAOS: the ends of the femur and tibia and the back of the patella are covered with articular cartilage)",
  "meniscus-medial": "C-shaped wedge on the medial plateau of the real tibia, open towards the centre of the knee (70°), outer edge at the plateau rim, inner edge at 56 % of it; height up to 5.5 mm and never above the real femur; shape after AAOS (\"wedge-shaped\"); sizes for visibility",
  "meniscus-lateral": "more circular wedge on the lateral plateau (open 34°), inner edge at 46 %; height up to 5 mm; sizes for visibility",
  "acl": "band 10 × 5.5 mm, quarter-turn twist, from the inner wall of the lateral femoral condyle (back of the notch) to the tibia in front of the spines",
  "pcl": "band 12.5 × 6.5 mm, from the inner wall of the medial femoral condyle (front of the notch) to the back of the tibia below the plateau; crosses the ACL",
  "mcl": "flat band 10 × 2 mm lying on the bones, from the medial femoral epicondyle to the tibia 61.2 mm below the joint line (StatPearls NBK507780)",
  "lcl": "cord 5 mm, from the lateral femoral epicondyle to the head of the fibula"
 },
